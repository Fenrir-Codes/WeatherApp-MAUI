<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.Views.MainPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#1E3A8A">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4A90E2" Offset="0.1" />
                <GradientStop Color="#1E3A8A" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <RefreshView x:Name="mainRefreshView" Refreshing="OnRefreshing" RefreshColor="#4A90E2">
            <ScrollView>
                <VerticalStackLayout Padding="20,10" Spacing="10">

                    <Grid ColumnDefinitions="*" Margin="0,10,0,5">
                        <Border Grid.Column="1"
                                BackgroundColor="#20FFFFFF"
                                Padding="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="45"
                                WidthRequest="45"
                                VerticalOptions="Center"
                                HorizontalOptions="End">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchClicked" />
                            </Border.GestureRecognizers>
                            <Image Source="search_icon.png" 
                                   HeightRequest="22" 
                                   WidthRequest="22"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
                        </Border>
                    </Grid>

                    <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Image Source="location.png" HeightRequest="18" WidthRequest="18" />
                        <Label x:Name="lblCity" Text="Loading..." FontSize="22" TextColor="White" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <!-- Finomított ikon és hőmérséklet méret a Samsung kijelzőhöz -->
                    <Image x:Name="ImgWeatherIcon" HeightRequest="130" WidthRequest="130" HorizontalOptions="Center" />

                    <Label x:Name="lblTemperature" Text="--" FontSize="75" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" Margin="0,-10" />

                    <Label x:Name="lblWeatherDescription" Text="--" FontSize="20" TextColor="White" HorizontalOptions="Center" Opacity="0.9" />

                    <!-- Információs kártya -->
                    <Border BackgroundColor="#20000000" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 20" Margin="0,10">
                        <Grid ColumnDefinitions="*, *, *">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                                <Image Source="wind_icon.png" HeightRequest="22" WidthRequest="22" />
                                <Label x:Name="lblWind" Text="--" TextColor="White" FontSize="12" HorizontalOptions="Center" />
                                <Label Text="Wind" TextColor="White" FontSize="10" Opacity="0.6" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                                <Image Source="moisture.png" HeightRequest="22" WidthRequest="22" />
                                <Label x:Name="lblHunidity" Text="--" TextColor="White" FontSize="12" HorizontalOptions="Center" />
                                <Label Text="Humidity" TextColor="White" FontSize="10" Opacity="0.6" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="5">
                                <Image Source="feels_like.png" HeightRequest="22" WidthRequest="22"/>
                                <Label x:Name="lblFeelsLike" Text="--" TextColor="White" FontSize="12" HorizontalOptions="Center" />
                                <Label Text="Feels like" TextColor="White" FontSize="10" Opacity="0.6" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Next Days szekció -->
                    <Grid ColumnDefinitions="*, Auto" Margin="5,10,10,0">
                        <Label Text="3 Hourly Forecast" 
                               TextColor="White" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center" />

                        <Border Grid.Column="1" 
                                BackgroundColor="#20FFFFFF" 
                                StrokeThickness="0" 
                                Padding="14,8" 
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSevenDaysTapped" />
                            </Border.GestureRecognizers>
                            
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="Next Days" 
                                       TextColor="White" 
                                       FontSize="13" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Image Source="arrow_right.png" 
                                       HeightRequest="16" 
                                       WidthRequest="16" 
                                       VerticalOptions="Center"  
                                       Aspect="AspectFit" />
                            </HorizontalStackLayout>
                            
                        </Border>
                    </Grid>

                    <CollectionView x:Name="forecastCollection" ItemsLayout="HorizontalList" HeightRequest="130">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- Növelve a szélességet 100-ra, hogy kényelmesen elférjen a per jel is -->
                                <Border Margin="0,0,15,0" Padding="12" BackgroundColor="#20FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="100">
                                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">

                                        <!-- Ez a rész teszi egy sorba a két hőmérsékletet -->
                                        <Label HorizontalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span 
                                                        Text="{Binding main.temperature, StringFormat='{0:F0}°'}" 
                                                        FontSize="15" 
                                                        FontAttributes="Bold" 
                                                        TextColor="White" />
                                                    <Span 
                                                        Text=" " 
                                                        FontSize="13" 
                                                        TextColor="White" 
                                                    />
                                                    <Span Text="{Binding main.temp_min, StringFormat='{0:F0}°'}" 
                                                        FontSize="12" 
                                                        TextColor="White" 
                                                    />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Image 
                                            Source="{Binding weather[0].customIcon}" 
                                            HeightRequest="35" 
                                            WidthRequest="35" 
                                            HorizontalOptions="Center" />

                                        <Label 
                                            Text="{Binding dateTime}" 
                                            FontSize="11" 
                                            TextColor="White" 
                                            Opacity="0.7" 
                                            HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>